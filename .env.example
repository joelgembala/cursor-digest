# AutoBrief — Environment Variables
# Copy to .env and fill in your values. Never commit .env.

# ── Circuit AI (required) ─────────────────────────────────────────────────────
# Cisco's Enterprise GenAI gateway (chat-ai.cisco.com)
# Request credentials via your team's Circuit onboarding process.
BRIDGE_API_CLIENT_ID=
BRIDGE_API_CLIENT_SECRET=
BRIDGE_API_APP_KEY=

# Optional Circuit overrides (defaults shown)
# CIRCUIT_TOKEN_URL=https://id.cisco.com/oauth2/default/v1/token
# CIRCUIT_API_ENDPOINT=https://chat-ai.cisco.com/
# CIRCUIT_API_VERSION=2025-04-01-preview
# CIRCUIT_MODEL=gpt-5-nano

# ── Webex (required for Webex message ingestion) ─────────────────────────────
# Register an integration at https://developer.webex.com/my-apps
# Required scopes: spark:messages_read, spark:rooms_read, spark:kms,
#                  meeting:transcripts_read, meeting:participants_read, meeting:schedules_read
WEBEX_CLIENT_ID=
WEBEX_CLIENT_SECRET=

# ── Microsoft To Do (required for task creation) ─────────────────────────────
# Register an app at https://portal.azure.com → App registrations
MS_TODO_CLIENT_ID=
# Optional — leave blank if your app uses public client (device code) flow
MS_TODO_TENANT_ID=
MS_TODO_CLIENT_SECRET=

# ── Jira (optional — weekly story generation) ─────────────────────────────────
# API token from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=
JIRA_API_TOKEN=
